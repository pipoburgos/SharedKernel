<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Description>C# DDD Distributed Services Layer</Description>
    <PackageId>Pipoburgos.SharedKernel.Api</PackageId>
    <PackageTags>C# DDD AggregateRoot Entity ValueObject Event EventBus Specification Repository</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.*" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.*" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.*" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="11.0.*" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.*" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="System.Text.Encodings.Web" Version="11.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\SharedKernel.Infrastructure.csproj" />
  </ItemGroup>

</Project>
